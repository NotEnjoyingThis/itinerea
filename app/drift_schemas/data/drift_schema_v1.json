        }
      ]
    },
    {
      "name": "operation_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"operation_rows\" (\"id\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"hlc\" TEXT NOT NULL, \"schema_version\" INTEGER NOT NULL, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"fields\" TEXT NOT NULL, \"space\" TEXT NOT NULL, \"is_local\" INTEGER NOT NULL CHECK (\"is_local\" IN (0, 1)), \"sent_at_millis\" INTEGER NULL, PRIMARY KEY (\"id\"));"
