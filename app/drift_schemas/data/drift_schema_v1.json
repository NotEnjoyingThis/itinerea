        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entity_rows\" (\"id\" TEXT NOT NULL, \"entity\" TEXT NOT NULL, \"trip_id\" TEXT NULL, \"parent_id\" TEXT NULL, \"fields\" TEXT NOT NULL, \"deleted_hlc\" TEXT NULL, PRIMARY KEY (\"id\"));"
